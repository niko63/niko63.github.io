---
import Base from '../../layouts/Base.astro';
import PageTitle from '../../components/PageTitle.astro';
import { LANGS, type Lang } from '../../config';
import { asset, t } from '../../i18n/ui';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;

const intro = {
  fr: 'Ce qui ne va nulle part ailleurs.',
  en: 'What fits nowhere else.',
}[lang];

// Article : le rubber-banding dans Mario Kart (PDF dans public/files/fun/).
const P = {
  fr: {
    title: 'Mario Kart : pourquoi la carapace bleue vous rattrape',
    sub: 'Le rubber-banding dans Mario Kart : analyse d’un mécanisme de rattrapage et enjeux de conception',
    text: 'Un joueur en tête peut perdre la première place à cause d’objets de rattrapage distribués aux retardataires. L’article documente ce mécanisme depuis son apparition dans la série, recense les stratégies des joueurs pour en limiter l’effet, puis le relie à l’ajustement dynamique de la difficulté, en comparant avec d’autres jeux, le sport et la redistribution économique.',
    pdfFr: 'Lire l’article (PDF, français)',
    pdfEn: 'English version (PDF)',
    meta: 'Nicolas Daclin · 15 pages',
  },
  en: {
    title: 'Mario Kart: why the blue shell always catches you',
    sub: 'Rubber-Banding in Mario Kart: Analyzing a Catch-Up Mechanic and Its Design Implications',
    text: 'A player leading the race can lose first place to catch-up items given preferentially to trailing players. The article documents this mechanic from its first appearance in the series, catalogs the strategies players use to limit its effect, then connects it to dynamic difficulty adjustment, comparing it with other games, sport and economic redistribution.',
    pdfFr: 'French version (PDF)',
    pdfEn: 'Read the article (PDF, English)',
    meta: 'Nicolas Daclin · 15 pages',
  },
}[lang];

// Plongée : photos dans public/fun/plongee-alger/. Pour en ajouter, copie une ligne de la liste.
const dive = {
  title: { fr: 'Plongée en Algérie', en: 'Diving in Algeria' }[lang],
  sub: { fr: 'Baie d’Alger, été 2024', en: 'Bay of Algiers, summer 2024' }[lang],
  photos: [
    { src: 'fun/plongee-alger/plongee-1.jpg', alt: { fr: 'Éponges orange et oursin noir sur un tombant rocheux', en: 'Orange sponges and a black sea urchin on a rocky drop-off' } },
    { src: 'fun/plongee-alger/plongee-2.jpg', alt: { fr: 'Plongeur en pleine eau au-dessus des rochers couverts d’algues', en: 'Diver in open water above algae-covered rocks' } },
    { src: 'fun/plongee-alger/plongee-3.jpg', alt: { fr: 'Plongeur qui s’éloigne le long d’une falaise sous-marine', en: 'Diver swimming away along an underwater cliff' } },
    { src: 'fun/plongee-alger/plongee-4.jpg', alt: { fr: 'Selfie sous l’eau, bulles et fond rocheux', en: 'Underwater selfie, bubbles and rocky seabed' } },
    { src: 'fun/plongee-alger/plongee-5.jpg', alt: { fr: 'Tombant rocheux orné d’éponges orange, en eau bleue', en: 'Rocky drop-off with orange sponges in blue water' } },
  ].map((p) => ({ src: p.src, alt: p.alt[lang] })),
};
---

<Base lang={lang} path="fun/" title={t(lang, 'fun.title')}>
  <PageTitle title={t(lang, 'fun.title')} intro={intro} emoji="🎲" />

  <div class="wrap grid gap-5 py-8">
    <!-- Pour ajouter un élément : copie le bloc <section> ci-dessous et change son contenu. -->
    <section class="card-box p-6" aria-labelledby="rubber">
      <h2 id="rubber" class="text-xl font-semibold">🏎️ {P.title}</h2>
      <p class="mt-1 text-sm italic text-muted">{P.sub}</p>
      <p class="mt-3 max-w-[70ch]">{P.text}</p>
      <p class="mt-1 text-sm text-muted">{P.meta}</p>
      <p class="mt-4 flex flex-wrap gap-2">
        <a class="btn btn-primary" href={lang === 'fr' ? asset('files/fun/rubber-banding-mariokart-fr.pdf') : asset('files/fun/rubber-banding-mariokart-en.pdf')} data-goatcounter-click="download:/files/fun/rubber-banding-mariokart" download>{lang === 'fr' ? P.pdfFr : P.pdfEn}</a>
        <a class="btn" href={lang === 'fr' ? asset('files/fun/rubber-banding-mariokart-en.pdf') : asset('files/fun/rubber-banding-mariokart-fr.pdf')} data-goatcounter-click="download:/files/fun/rubber-banding-mariokart-other" download>{lang === 'fr' ? P.pdfEn : P.pdfFr}</a>
      </p>
    </section>

    <section class="card-box p-6" aria-labelledby="dive">
      <h2 id="dive" class="text-xl font-semibold">🤿 {dive.title}</h2>
      <p class="mt-1 text-sm text-muted">{dive.sub}</p>
      <ul class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {dive.photos.map((p) => (
          <li>
            <a href={asset(p.src)} class="block overflow-hidden rounded-xl border border-line">
              <img src={asset(p.src)} alt={p.alt} class="aspect-[4/3] w-full object-cover" loading="lazy" />
            </a>
          </li>
        ))}
      </ul>
    </section>
  </div>
</Base>
