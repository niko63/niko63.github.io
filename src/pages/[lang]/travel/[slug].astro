---
import { render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import PageTitle from '../../../components/PageTitle.astro';
import Gallery from '../../../components/Gallery.astro';
import TripCard from '../../../components/TripCard.astro';
import { LANGS, type Lang } from '../../../config';
import { asset, href, localeTag, pick, t, type UiKey } from '../../../i18n/ui';
import { getCircuits, getPays, getSejours } from '../../../lib/content';

export async function getStaticPaths() {
  const list = await getPays();
  return LANGS.flatMap((lang) => list.map((entry) => ({ params: { lang, slug: entry.id }, props: { entry } })));
}
const lang = Astro.params.lang as Lang;
const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const sejours = (await getSejours()).filter((s) => s.data.pays.id === entry.id);
const circuits = (await getCircuits()).filter((c) => c.data.pays.some((p) => p.id === entry.id));
const hasBody = Boolean(entry.body?.trim());
const nf = new Intl.NumberFormat(localeTag[lang]);
const fmtArea = d.area ? `${nf.format(d.area)} km²` : '';
const fmtPop = d.population
  ? d.population >= 1e6
    ? `≈ ${new Intl.NumberFormat(localeTag[lang], { maximumFractionDigits: d.population < 2e7 ? 1 : 0 }).format(d.population / 1e6)} M`
    : `≈ ${nf.format(d.population)}`
  : '';
const facts = [
  { label: t(lang, 'country.capital'), value: pick(d, 'capital', lang) },
  { label: t(lang, 'country.location'), value: pick(d, 'location', lang) },
  { label: t(lang, 'country.area'), value: fmtArea },
  { label: t(lang, 'country.population'), value: fmtPop },
].filter((f) => f.value);
const intro = pick(d, 'intro', lang);
const fact = pick(d, 'fact', lang);
const story = pick(d, 'story', lang);
---

<Base lang={lang} path={`travel/${entry.id}/`} title={pick(d, 'title', lang)} description={pick(d, 'summary', lang)}>
  <div class="wrap pt-8">
    <a href={href(lang, 'travel')} class="text-sm text-muted hover:text-accent">{t(lang, 'travel.back')}</a>
  </div>
  <PageTitle title={pick(d, 'title', lang)} emoji={d.flag} intro={pick(d, 'summary', lang)} />

  <div class="wrap py-8">
    {d.cover && <img src={asset(d.cover)} alt="" class="mb-6 max-h-[28rem] w-full rounded-2xl object-cover" />}
    <p class="flex flex-wrap gap-2 text-sm">
      <span class="chip">{t(lang, `continent.${d.continent}` as UiKey)}</span>
      {d.when && <span class="chip">{d.when}</span>}
    </p>

    {
      facts.length > 0 && (
        <dl class="mt-6 grid gap-3 sm:grid-cols-2 xl:grid-cols-4">
          {facts.map((f) => (
            <div class="card-box p-4">
              <dt class="text-sm text-muted">{f.label}</dt>
              <dd class="mt-1 text-lg font-semibold">{f.value}</dd>
            </div>
          ))}
        </dl>
      )
    }
    {facts.length > 0 && <p class="mt-2 text-xs text-muted">{t(lang, entry.id === 'france' ? 'country.noteFrance' : 'country.note')}</p>}
    {
      (intro || fact || story) && (
        <div class:list={['mt-6 grid gap-8', story && 'lg:grid-cols-2']}>
          {(intro || fact) && (
            <section aria-labelledby="about">
              <h2 id="about" class="text-2xl font-semibold">{t(lang, 'country.about')}</h2>
              {intro && <p class="mt-3 text-lg">{intro}</p>}
              {fact && (
                <p class="mt-6 border-l-2 border-accent pl-4 text-muted">
                  <span class="block text-xs font-semibold uppercase tracking-wider text-accent">{t(lang, 'country.didYouKnow')}</span>
                  <span class="mt-1 block text-base italic">{fact}</span>
                </p>
              )}
            </section>
          )}
          {story && (
            <section aria-labelledby="story">
              <h2 id="story" class="text-2xl font-semibold">{t(lang, 'country.story')}</h2>
              <div class="mt-3 space-y-4 text-lg">
                {story.split(/\n\s*\n/).map((para) => <p>{para.trim()}</p>)}
              </div>
            </section>
          )}
        </div>
      )
    }

    {hasBody && <div class="prose prose-lg mt-8 max-w-none"><Content /></div>}

    {
      circuits.length > 0 && (
        <section class="mt-10" aria-labelledby="c">
          <h2 id="c" class="text-2xl font-semibold">{t(lang, 'travel.circuits')}</h2>
          <ul class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3 2xl:grid-cols-4">
            {circuits.map((c) => (
              <li>
                <TripCard href={href(lang, `travel/circuit/${c.id}`)} title={pick(c.data, 'title', lang)} kicker={pick(c.data, 'duration', lang)} text={pick(c.data, 'summary', lang)} cover={c.data.cover} emoji="🧭" />
              </li>
            ))}
          </ul>
        </section>
      )
    }
    {
      sejours.length > 0 && (
        <section class="mt-10" aria-labelledby="s">
          <h2 id="s" class="text-2xl font-semibold">{t(lang, 'travel.stays')}</h2>
          <ul class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3 2xl:grid-cols-4">
            {sejours.map((s) => (
              <li>
                <TripCard href={href(lang, `travel/stay/${s.id}`)} title={pick(s.data, 'title', lang)} kicker={pick(s.data, 'duration', lang)} text={pick(s.data, 'summary', lang)} cover={s.data.cover} emoji="📍" />
              </li>
            ))}
          </ul>
        </section>
      )
    }
    <Gallery lang={lang} photos={d.gallery} />
  </div>
</Base>
