---
import Base from '../../../layouts/Base.astro';
import PageTitle from '../../../components/PageTitle.astro';
import WorldMap from '../../../components/WorldMap.astro';
import TripCard from '../../../components/TripCard.astro';
import { LANGS, type Lang } from '../../../config';
import { href, pick, t, type UiKey } from '../../../i18n/ui';
import { getCircuits, getPays, getSejours } from '../../../lib/content';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const pays = await getPays();
const sejours = await getSejours();
const circuits = await getCircuits();

const continents = [...new Set(pays.map((p) => p.data.continent))];
const countryName = (id: string) => {
  const p = pays.find((x) => x.id === id);
  return p ? pick(p.data, 'title', lang) : id;
};
const stats = [
  { n: pays.length, label: t(lang, 'travel.countries') },
  { n: continents.length, label: t(lang, 'travel.continents') },
  { n: sejours.length, label: t(lang, 'travel.stays') },
  { n: circuits.length, label: t(lang, 'travel.circuits') },
];

const mapCountries = pays.map((p) => ({ iso: p.data.iso, slug: p.id, name: pick(p.data, 'title', lang), coords: p.data.coords }));
const mapStays = sejours
  .filter((s) => s.data.coords)
  .map((s) => ({ slug: s.id, name: pick(s.data, 'title', lang), coords: s.data.coords! }));
const mapCircuits = circuits
  .filter((c) => c.data.steps.length > 1 && c.data.steps.every((s) => s.coords))
  .map((c) => ({ slug: c.id, name: pick(c.data, 'title', lang), points: c.data.steps.map((s) => s.coords!) }));
---

<Base lang={lang} path="travel/" title={t(lang, 'travel.title')} description={t(lang, 'travel.intro')}>
  <PageTitle title={t(lang, 'travel.title')} intro={t(lang, 'travel.intro')} emoji="🧳" />

  <div class="wrap pb-6">
    <ul class="grid grid-cols-2 gap-3 sm:grid-cols-4">
      {
        stats.map((s) => (
          <li class="card-box p-4">
            <p class="text-3xl font-bold text-accent">{s.n}</p>
            <p class="text-sm text-muted">{s.label}</p>
          </li>
        ))
      }
    </ul>
  </div>

  <section class="wrap py-6" aria-labelledby="map-title">
    <h2 id="map-title" class="sr-only">{t(lang, 'travel.map')}</h2>
    <WorldMap lang={lang} countries={mapCountries} stays={mapStays} circuits={mapCircuits} />
  </section>

  <section class="wrap py-8" aria-labelledby="by-continent">
    <h2 id="by-continent" class="text-2xl font-semibold">{t(lang, 'travel.byContinent')}</h2>
    {
      continents.map((c) => (
        <div class="mt-6">
          <h3 class="text-lg font-semibold text-muted">{t(lang, `continent.${c}` as UiKey)}</h3>
          <ul class="mt-3 grid gap-4 sm:grid-cols-2 lg:grid-cols-3 2xl:grid-cols-4">
            {pays
              .filter((p) => p.data.continent === c)
              .map((p) => (
                <li>
                  <TripCard
                    href={href(lang, `travel/${p.id}`)}
                    title={pick(p.data, 'title', lang)}
                    kicker={p.data.when}
                    text={pick(p.data, 'summary', lang)}
                    cover={p.data.cover}
                    emoji={p.data.flag}
                  />
                </li>
              ))}
          </ul>
        </div>
      ))
    }
  </section>

  {
    circuits.length > 0 && (
      <section class="wrap py-8" aria-labelledby="circuits">
        <h2 id="circuits" class="text-2xl font-semibold">{t(lang, 'travel.circuits')}</h2>
        <p class="mt-1 text-muted">{t(lang, 'travel.circuitsIntro')}</p>
        <ul class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3 2xl:grid-cols-4">
          {circuits.map((c) => (
            <li>
              <TripCard
                href={href(lang, `travel/circuit/${c.id}`)}
                title={pick(c.data, 'title', lang)}
                kicker={[c.data.pays.map((p) => countryName(p.id)).join(', '), pick(c.data, 'duration', lang)].filter(Boolean).join(' · ')}
                text={pick(c.data, 'summary', lang)}
                cover={c.data.cover}
                emoji="🧭"
              />
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    sejours.length > 0 && (
      <section class="wrap py-8" aria-labelledby="stays">
        <h2 id="stays" class="text-2xl font-semibold">{t(lang, 'travel.stays')}</h2>
        <p class="mt-1 text-muted">{t(lang, 'travel.staysIntro')}</p>
        <ul class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3 2xl:grid-cols-4">
          {sejours.map((s) => (
            <li>
              <TripCard
                href={href(lang, `travel/stay/${s.id}`)}
                title={pick(s.data, 'title', lang)}
                kicker={[countryName(s.data.pays.id), pick(s.data, 'duration', lang)].filter(Boolean).join(' · ')}
                text={pick(s.data, 'summary', lang)}
                cover={s.data.cover}
                emoji="📍"
              />
            </li>
          ))}
        </ul>
      </section>
    )
  }
</Base>
