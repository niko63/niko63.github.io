---
interface Props {
  title: string;
  intro?: string;
  emoji?: string;
  /** Réservé (couleur de section) : sans effet dans ce thème. */
  color?: 'c1' | 'c2' | 'c3' | 'c4';
}
const { title, intro, emoji } = Astro.props;
---

<header class="wrap pb-6 pt-12">
  <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">
    {emoji && <span aria-hidden="true" class="mr-2">{emoji}</span>}{title}
  </h1>
  {intro && <p class="mt-3 max-w-2xl text-lg text-muted">{intro}</p>}
</header>
