---
interface Props {
  title: string;
  intro?: string;
  emoji?: string;
}
const { title, intro, emoji } = Astro.props;
---

<header class="mx-auto max-w-5xl px-4 pt-12 pb-6">
  <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">
    {emoji && <span aria-hidden="true" class="mr-2">{emoji}</span>}{title}
  </h1>
  {intro && <p class="mt-3 max-w-2xl text-lg text-muted">{intro}</p>}
</header>
