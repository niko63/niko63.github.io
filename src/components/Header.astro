---
import { SITE, type Lang } from '../config';
import { href, t, type UiKey } from '../i18n/ui';

interface Props {
  lang: Lang;
  path: string;
}
const { lang, path } = Astro.props;
const other: Lang = lang === 'fr' ? 'en' : 'fr';

const items: { key: UiKey; to: string }[] = [
  { key: 'nav.about', to: 'about' },
  { key: 'nav.work', to: 'work' },
  { key: 'nav.travel', to: 'travel' },
  { key: 'nav.auvergne', to: 'auvergne' },
  { key: 'nav.fun', to: 'fun' },
];
const current = path.replace(/\/$/, '').split('/')[0];
---

<header class="sticky top-0 z-40 border-b border-line bg-bg/85 backdrop-blur">
  <div class="wrap flex items-center justify-between gap-4 py-3.5">
    <a href={href(lang)} class="flex items-center gap-2 text-lg font-bold tracking-tight">
      <span
        class="grid h-8 w-8 place-items-center rounded-lg bg-accent text-base text-accent-fg"
        aria-hidden="true">{SITE.name.charAt(0)}</span
      >
      <span>{SITE.name}</span>
    </a>

    <nav aria-label="Navigation principale" class="hidden md:block">
      <ul class="flex items-center gap-1">
        {
          items.map((i) => (
            <li>
              <a
                href={href(lang, i.to)}
                aria-current={current === i.to ? 'page' : undefined}
                class:list={[
                  'rounded-lg px-3 py-2 text-sm font-medium hover:bg-accent-soft hover:text-accent',
                  current === i.to ? 'bg-accent-soft text-accent' : 'text-muted',
                ]}
              >
                {t(lang, i.key)}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-1">
      <a href={href(lang, 'search')} class="icon-btn" aria-label={t(lang, 'nav.search')} title={t(lang, 'nav.search')}>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
      </a>
      <a
        href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/${other}/${path}`}
        hreflang={other}
        lang={other}
        class="icon-btn"
        title={t(lang, 'lang.switch')}
        aria-label={t(lang, 'lang.switch')}>{t(lang, 'lang.switchShort')}</a
      >
      <button
        type="button"
        id="theme-toggle"
        class="icon-btn"
        aria-label={t(lang, 'theme.toggle')}
        data-label-auto={t(lang, 'theme.auto')}
        data-label-light={t(lang, 'theme.light')}
        data-label-dark={t(lang, 'theme.dark')}
      >
        <span id="theme-icon" aria-hidden="true">🌓</span>
      </button>
      <button
        type="button"
        id="menu-toggle"
        class="icon-btn md:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label={t(lang, 'nav.menu')}
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"></path></svg>
      </button>
    </div>
  </div>

  <nav id="mobile-menu" aria-label="Navigation mobile" class="hidden border-t border-line md:hidden">
    <ul class="wrap py-2">
      {
        items.map((i) => (
          <li>
            <a
              href={href(lang, i.to)}
              aria-current={current === i.to ? 'page' : undefined}
              class="block rounded-lg px-3 py-3 font-medium hover:bg-accent-soft"
            >
              {t(lang, i.key)}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<script>
  // Menu mobile
  const menuBtn = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  menuBtn?.addEventListener('click', () => {
    const open = menuBtn.getAttribute('aria-expanded') === 'true';
    menuBtn.setAttribute('aria-expanded', String(!open));
    menu?.classList.toggle('hidden', open);
  });

  // Thème : automatique -> clair -> sombre -> automatique
  const btn = document.getElementById('theme-toggle');
  const icon = document.getElementById('theme-icon');
  const root = document.documentElement;
  type Mode = 'auto' | 'light' | 'dark';
  const icons: Record<Mode, string> = { auto: '🌓', light: '☀️', dark: '🌙' };

  function current(): Mode {
    try {
      const m = localStorage.getItem('theme');
      if (m === 'light' || m === 'dark') return m;
    } catch {}
    return 'auto';
  }
  function apply(mode: Mode) {
    if (mode === 'auto') root.removeAttribute('data-theme');
    else root.setAttribute('data-theme', mode);
    try {
      if (mode === 'auto') localStorage.removeItem('theme');
      else localStorage.setItem('theme', mode);
    } catch {}
    if (icon) icon.textContent = icons[mode];
    const label = btn?.getAttribute(`data-label-${mode}`);
    if (btn && label) {
      btn.setAttribute('title', label);
      btn.setAttribute('aria-label', label);
    }
  }
  apply(current());
  btn?.addEventListener('click', () => {
    const order: Mode[] = ['auto', 'light', 'dark'];
    apply(order[(order.indexOf(current()) + 1) % order.length]);
  });
</script>
