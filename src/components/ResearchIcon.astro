---
// Pictogrammes de la page Recherche : même trait, même palette (couleur du thème), fond doux.
interface Props { name: 'model' | 'simulate' | 'interop' | 'resilient' | 'horizon'; class?: string }
const { name, class: cls = '' } = Astro.props;
const soft = 'var(--accent-soft)';
---

<svg viewBox="0 0 64 64" width="56" height="56" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class={cls}>
  {name === 'model' && (
    <>
      <circle cx="9" cy="32" r="5" fill={soft} />
      <path d="M14 32h5" />
      <rect x="19" y="23" width="18" height="18" rx="4" fill={soft} />
      <path d="M23 29h10M23 35h6" />
      <path d="M37 32h4" />
      <path d="M41 32l8-8 8 8-8 8z" fill={soft} />
      <path d="M49 24V12M49 40v12" />
      <circle cx="49" cy="10" r="2.2" fill="currentColor" stroke="none" />
      <circle cx="49" cy="54" r="2.2" fill="currentColor" stroke="none" />
    </>
  )}
  {name === 'simulate' && (
    <>
      <path d="M10 8v46h46" />
      <path d="M16 44c6 0 7-18 14-18s7 14 12 14 6-24 12-26" />
      <path d="M16 44c6 0 7-18 14-18" stroke-dasharray="1 5" />
      <circle cx="46" cy="14" r="9" fill={soft} />
      <path d="M43 10.5v7l6-3.5z" fill="currentColor" />
    </>
  )}
  {name === 'interop' && (
    <>
      <circle cx="24" cy="32" r="16" fill={soft} />
      <circle cx="40" cy="32" r="16" fill={soft} fill-opacity="0.7" />
      <path d="M26 33l4 4 8-9" stroke-width="3" />
    </>
  )}
  {name === 'resilient' && (
    <>
      <path d="M32 7l20 7v18c0 12-9 21-20 25C21 53 12 44 12 32V14z" fill={soft} />
      <path d="M17 34h8l4-9 6 17 4-8h8" />
    </>
  )}
  {name === 'horizon' && (
    <>
      <path d="M40 26l16 8.5v17L40 60 24 51.5v-17z" stroke-dasharray="3 4" opacity="0.6" />
      <path d="M26 9l18 10v20L26 49 8 39V19z" fill={soft} />
      <path d="M26 29l18-10M26 29L8 19M26 29v20" />
      <path d="M52 8v8M48 12h8" />
    </>
  )}
</svg>
