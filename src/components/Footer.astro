---
import { SITE, type Lang } from '../config';
import { t } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="mt-24 border-t-2 border-fg">
  <div class="wrap flex flex-col gap-3 py-10 text-sm text-muted sm:flex-row sm:items-center sm:justify-between">
    <p>© {year} {SITE.name} · {t(lang, 'footer.rights')}</p>
    <ul class="flex flex-wrap items-center gap-4">
      {SITE.links.github && <li><a class="hover:text-accent underline-offset-4 hover:underline" href={SITE.links.github} rel="noopener">GitHub</a></li>}
      {SITE.links.hal && <li><a class="hover:text-accent underline-offset-4 hover:underline" href={SITE.links.hal} rel="noopener">HAL</a></li>}
      {SITE.links.email && <li><a class="hover:text-accent underline-offset-4 hover:underline" href={`mailto:${SITE.links.email}`}>{SITE.links.email}</a></li>}
      <li>{t(lang, 'footer.built')}</li>
    </ul>
  </div>
</footer>
